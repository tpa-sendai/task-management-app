<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>タスクを追加 - タスク一覧</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container">
    <header>
      <h1><span class="dot"></span>タスクを追加</h1>
      <a class="btn btn-secondary" href="/tasks">← 戻る</a>
    </header>

    <section class="card">
      <form action="/tasks/add" method="POST">
        <div class="form-group">
          <label for="title">タイトル</label>
          <input type="text" id="title" name="title" required>
        </div>
        
        <div class="form-group">
          <label for="completed">状態</label>
          <select id="completed" name="completed" required>
            <option value="">選択してください</option>
            <option value="未完了" selected>未完了</option>
            <option value="完了">完了</option>
          </select>
        </div>
        
        <div class="form-actions">
          <button type="submit" class="btn">追加</button>
          <a href="/tasks" class="btn btn-secondary">キャンセル</a>
        </div>
      </form>
    </section>
  </div>
</body>
</html>
