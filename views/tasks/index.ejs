<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>タスク一覧</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container">
    <header>
      <h1><span class="dot"></span>タスク一覧</h1>
      <a class="btn" href="/tasks/add">＋ タスクを追加</a>
    </header>

    <section class="card">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>タイトル</th>
            <th>状態</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <% for(let task of tasks) { %>
            <td><%= task.id %></td>
            <td class="task-title <%= task.completed ? "completed" : "" %>">
                <%= task.title %></td>
            <td class="status <%= task.completed ? "completed" : "" %>">
                <%= task.completed ? "完了" : "未完了" %>
            </td>
            <td class="row-actions">
              <% if(!task.completed) { %>
                <form action="/tasks/complete/<%= task.id %>" method="POST" style="display: inline;">
                    <button type="submit" class="btn-small btn-complete">完了</button>
                </form>
              <% } %>
              <a href="/tasks/edit/<%= task.id %>">編集</a>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </section>
  </div>
</body>
</html>
